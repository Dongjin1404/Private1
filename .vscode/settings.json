{
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false
  },
  // Default model for Copilot Chat — applies to local VS Code AND web-based Codespaces.
  // Claude Sonnet 4.5 and Opus 4.5 may not appear in the model picker UI in all
  // environments, but this setting routes requests to the specified model regardless.
  // To switch to Claude Opus 4.5, change the value to "claude-opus-4-5".
  "github.copilot.chat.languageModel": "claude-sonnet-4-5",
  "github.copilot.chat.agent.thinkingTool": true,
  "chat.agent.enabled": true
}
